# ================================================================================================
# Environment Variables Template for Elderly Welfare Chatbot
# ================================================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# ================================================================================================

# Django Settings
SECRET_KEY=django-insecure-change-this-to-a-random-50-character-string-in-production
DEBUG=False
ALLOWED_HOSTS=4senior.o-r.kr,43.202.39.220,localhost,127.0.0.1

# Database Settings
POSTGRES_DB=elderly_rag_db
POSTGRES_USER=elderly_rag_user
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# OpenAI Settings
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Embedding Settings (for document vectorization)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB Settings (벡터 데이터베이스 - Django와 별도 서비스)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chromadb_storage

# Disable Chroma telemetry (set to true to enable)
CHROMA_TELEMETRY=false
CHROMA_TELEMETRY_ENABLED=false
CHROMA_ANONYMIZED_TELEMETRY=false

# RAG Settings
LOAD_DOCUMENTS=true
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
HYBRID_RERANK_WEIGHT=0.7

# Django Server Settings
SERVER_IP=43.202.39.220
SERVER_DOMAIN=4senior.o-r.kr
DJANGO_PORT=8080
GUNICORN_BIND=0.0.0.0:8080

# Kakao OAuth Settings
KAKAO_REST_API_KEY=54d356a020d597f5e8b9540f3e82703d
